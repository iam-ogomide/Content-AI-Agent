GEMINI_API_KEY=your-gemini-api-key-here
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/your-db-name?retryWrites=true&w=majority
MONGO_DB=your-db-name

# Optional. All have working defaults in the code — set them only to override.
GEMINI_MODEL=gemini-3.1-flash-lite
CANVA_AUTH_TIMEOUT=300
# Must also be listed as an allowed redirect on the Canva app itself.
CANVA_REDIRECT_URI=http://localhost:8765/callback

# Optional LangSmith tracing (backend/tracing.py). Off unless LANGSMITH_TRACING
# is true AND a key is set. Prompts and completions are sent to LangSmith when on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=creditchek-content
# Only for the EU data region; omit for US.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
